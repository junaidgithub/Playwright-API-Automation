{
  "info": {
    "_postman_id": "00000000-test-fixture-auth-chain",
    "name": "Test Fixture - Auth, Chaining and Failures",
    "description": "Synthetic collection used by the tool's own end-to-end test. All credentials are fake test values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:1" },
    { "key": "username", "value": "qa_user" }
  ],
  "item": [
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a('string');",
                  "    pm.expect(body).to.have.property('expiresIn', 3600);",
                  "    pm.environment.set(\"authToken\", body.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Debug", "value": "1", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"S3cr3t-Pass!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Create Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const jsonData = pm.response.json();",
                  "pm.test('Name echoed', function () { pm.expect(jsonData.name).to.eql('Widget'); });",
                  "pm.collectionVariables.set('itemId', jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Widget\", \"tags\": [\"a\", \"b\"] }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/items"
          }
        },
        {
          "name": "Get Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Body is correct', function () {",
                  "  var d = pm.response.json();",
                  "  pm.expect(d.name).to.eql('Widget');",
                  "  pm.expect(d.tags).to.be.an('array').that.includes('a');",
                  "  pm.expect(d).to.have.property('id');",
                  "});",
                  "pm.test('JSON content type', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Fast enough', () => { pm.expect(pm.response.responseTime).to.be.below(5000); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/items/{{itemId}}" }
        },
        {
          "name": "Get Item - intentional failing assertion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Name should be Gadget (deliberately wrong)', function () {",
                  "  pm.expect(pm.response.json().name).to.eql('Gadget');",
                  "});",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/items/{{itemId}}" }
        },
        {
          "name": "Missing item returns 404",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Not found', () => { pm.response.to.have.status(404); });"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/items/999999" }
        },
        {
          "name": "Unauthorized without token",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Rejected', () => { pm.response.to.be.unauthorized; });"] } }],
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/items/1" }
        },
        {
          "name": "Script with unsupported statements",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status ok', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { console.log('ok'); }",
                  "pm.sendRequest('https://example.invalid', function () {});",
                  "require('child_process').execSync('echo pwned');"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/items/{{itemId}}" }
        },
        {
          "name": "Delete Item",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Deleted', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"] } }],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/items/{{itemId}}" }
        }
      ]
    },
    {
      "name": "Errors",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Server error without expectations",
          "request": { "method": "GET", "url": "{{baseUrl}}/boom" }
        },
        {
          "name": "Unreachable host",
          "request": { "method": "GET", "url": "http://127.0.0.1:1/unreachable" }
        },
        {
          "name": "API key auth",
          "request": {
            "method": "GET",
            "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "X-API-Key" }, { "key": "value", "value": "live-key-ABC123456" }, { "key": "in", "value": "header" }] },
            "url": "{{baseUrl}}/apikey"
          },
          "response": [{ "name": "OK", "code": 200, "status": "OK" }]
        },
        {
          "name": "OAuth2 request (unsupported)",
          "request": { "method": "GET", "auth": { "type": "oauth2", "oauth2": [] }, "url": "{{baseUrl}}/items" }
        }
      ]
    }
  ]
}
