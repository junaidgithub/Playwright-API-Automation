# Copy to .env and adjust. Values here are defaults; nothing target-specific is hardcoded in the code.

# --- Target -----------------------------------------------------------------
# Replace scheme/host/port of every request URL in the collection (keeps paths & queries).
# Leave empty to use the URLs exactly as written in the collection.
TARGET_BASE_URL=

# Override any collection/environment variable: PM_VAR_<variableName>=value
# PM_VAR_baseUrl=https://qa.example.com
# PM_VAR_token=<set in your shell, never commit real tokens>

# --- Safety -----------------------------------------------------------------
# POST/PUT/PATCH/DELETE are skipped unless this is true. Only enable for non-production targets.
ALLOW_MUTATING_REQUESTS=false
# Retries never re-send mutating requests unless this is true.
RETRY_MUTATING_REQUESTS=false

# --- Execution --------------------------------------------------------------
WORKERS=1
RETRIES=0
REQUEST_TIMEOUT_MS=15000
TEST_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=900000
IGNORE_HTTPS_ERRORS=false

# --- Checks -----------------------------------------------------------------
# Baseline status check when the collection defines none: 2xx | non-5xx | none
BASELINE_STATUS=2xx
# Fail requests slower than this (0 = only record response times)
MAX_RESPONSE_TIME_MS=0

# --- Reports ----------------------------------------------------------------
REPORT_INCLUDE_BODIES=true
REPORT_BODY_LIMIT=4000
PLAYWRIGHT_HTML_REPORT=true

# --- Dashboard server -------------------------------------------------------
HOST=127.0.0.1
PORT=3000
MAX_UPLOAD_MB=5

# --- Folders (relative to project root) -------------------------------------
GENERATED_DIR=generated-tests
REPORT_DIR=reports
FILES_DIR=collections/files
